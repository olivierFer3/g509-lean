def var (v k : Nat) : Nat := 4 * v + k + 1
def posL (x : Nat) : Nat := 2 * x
def negL (x : Nat) : Nat := 2 * x + 1

def alo : List (List Nat) :=
  (List.range 509).map fun v => [posL (var v 0), posL (var v 1), posL (var v 2), posL (var v 3)]

def edgeCl : List (List Nat) :=
  edgeCode.flatMap fun e =>
    [0, 1, 2, 3].map fun k => [negL (var (e / 1024) k), negL (var (e % 1024) k)]

def units : List (List Nat) := [[posL (var 0 0)], [posL (var 149 1)], [posL (var 152 2)]]

def F : List (List Nat) := alo ++ edgeCl ++ units

